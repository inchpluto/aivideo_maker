# 默认严格调用真实供应商。缺少密钥会明确报错，不会伪装生成成功。
# 只有开发 UI 时才临时改为 true；也可在“模型与 API 接入中心”显式切换。
MOCK_MODE=false
PORT=4174
# 可选：将用户数据移到项目目录之外；升级代码不会覆盖该目录。
DATA_DIR=server/data
# 可选：完成 JSON→SQLite 迁移后启用本机 SQLite（需要 Node 22.5+）。
STORAGE_BACKEND=atomic-json
SQLITE_DATABASE=
# 真实 MP4 导出需要 FFmpeg/FFprobe；留空表示从 PATH 查找。
FFMPEG_PATH=
FFPROBE_PATH=

# 剧本、台词与 AI 剪辑提案（服务端读取，不会进入前端构建）
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2

# 可选文本路由：模型中心选择后自动按供应商调用
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 人物 / 环境图像
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# 角色声音
# 本地中文 / 英文 TTS 桥接服务（无需云端 API Key）
INDEXTTS_BASE_URL=http://127.0.0.1:7860
F5TTS_BASE_URL=http://127.0.0.1:7862
LOCAL_TTS_AUTOSTART=false
INDEXTTS_ROOT=
INDEXTTS_MODEL_DIR=
INDEXTTS_PYTHON=
F5TTS_APP=
F5TTS_PYTHON=

# 可选云端声音路由
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# 镜头视频
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gemini_omni_flash
